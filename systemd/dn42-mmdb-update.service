[Unit]
Description=Fetch latest DN42 MaxMind MMDB databases
Documentation=https://github.com/no42-org/dn42-mmdb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# No StateDirectory=: it takes a name under /var/lib and cannot follow
# DN42_MMDB_STATE_DIR, so hardcoding one meant that changing the variable below
# created an unused directory while the databases landed elsewhere. The service
# runs as root and the script creates the directory itself, so the variable is
# the single place the location is defined.
#
# Databases to fetch. Drop any you do not need, for example:
#   Environment=DN42_MMDB_DATABASES="dn42-asn.mmdb dn42-country.mmdb"
Environment=DN42_MMDB_DATABASES="dn42-asn.mmdb dn42-country.mmdb dn42-city.mmdb"
Environment=DN42_MMDB_STATE_DIR=/var/lib/dn42
Environment=DN42_MMDB_BASE_URL=https://github.com/no42-org/dn42-mmdb/releases/latest/download
ExecStart=/usr/bin/env bash -c '\
  set -euo pipefail; \
  TMP_DIR=$$(mktemp -d); \
  trap "rm -rf $${TMP_DIR}" EXIT; \
  mkdir -p "$${DN42_MMDB_STATE_DIR}"; \
  for db in $${DN42_MMDB_DATABASES}; do \
    curl -fsSL -o "$${TMP_DIR}/$${db}" "$${DN42_MMDB_BASE_URL}/$${db}"; \
    curl -fsSL -o "$${TMP_DIR}/$${db}.sha256" "$${DN42_MMDB_BASE_URL}/$${db}.sha256"; \
    (cd "$${TMP_DIR}" && sha256sum -c "$${db}.sha256"); \
  done; \
  for db in $${DN42_MMDB_DATABASES}; do \
    mv "$${TMP_DIR}/$${db}" "$${DN42_MMDB_STATE_DIR}/$${db}"; \
    chmod 0644 "$${DN42_MMDB_STATE_DIR}/$${db}"; \
  done \
'
